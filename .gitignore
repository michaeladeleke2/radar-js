.DS_Store
node_modules/
*.log
dist/
tests/.cache/
tests/out/
dist-lib/
.claude/
# Raw captures stay out of git (about 12 MB per 3 s clip); see data/README.md
data/captures/
# Live verification captures (about 236 MB per 60 s; the set is about 1 GB); see docs/verification-summary.md
test/captures/
# Python environment with the Infineon SDK, for tools/sdk_capture.py (not committed)
.venv-sdk/

# Live golden data (tools/make_golden.py --input): over 50 MB in all, as the
# captures it comes from. Each folder's manifest.json (committed) has the SHA-256 of every file.
test/golden/live/**/*.npy
